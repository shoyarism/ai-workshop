{
  "workshop-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "D:/ai-workshop/.venv/Scripts/python.exe D:/ai-workshop/scripts/workshop_hooks.py pre-tool $COMMAND",
            "timeout": 5
          }
        ]
      }
    ]
  }
}