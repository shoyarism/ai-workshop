{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "name": "Workshop UI/UX Master Tokens",
  "version": "2.0.0",
  "colors": {
    "brand": {
      "primary": "#6366f1",
      "primaryHover": "#4f46e5",
      "secondary": "#a855f7",
      "accent": "#06b6d4",
      "success": "#10b981",
      "warning": "#f59e0b",
      "danger": "#ef4444"
    },
    "dark": {
      "bgPrimary": "#090d16",
      "bgSecondary": "#111827",
      "bgCard": "#1e293b",
      "border": "#334155",
      "textPrimary": "#f8fafc",
      "textSecondary": "#94a3b8",
      "textMuted": "#64748b"
    },
    "light": {
      "bgPrimary": "#f8fafc",
      "bgSecondary": "#ffffff",
      "bgCard": "#ffffff",
      "border": "#e2e8f0",
      "textPrimary": "#0f172a",
      "textSecondary": "#475569",
      "textMuted": "#94a3b8"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "heading": "Geist Sans, Plus Jakarta Sans, Inter, sans-serif",
      "mono": "JetBrains Mono, 'Fira Code', monospace"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px",
      "5xl": "48px"
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radii": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
    "glass": "0 8px 32px 0 rgba(0, 0, 0, 0.37)"
  },
  "animation": {
    "spring": {
      "stiffness": 400,
      "damping": 30
    },
    "easeOutCubic": "cubic-bezier(0.33, 1, 0.68, 1)",
    "easeSmooth": "cubic-bezier(0.16, 1, 0.3, 1)"
  }
}
