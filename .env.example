# ==============================================================================
# Workshop Operating System — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure keys for active services.
# Note: Sensitive secrets are kept locally and never committed to Git.

# --- Notion Second Brain & Knowledge Base ---
NOTION_TOKEN=your_notion_token_here

# --- OmniRoute / LiteLLM Proxy Gateway ---
OMNIROUTE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=omniroute-local

# --- Stealth Anti-Detect Browser (Camofox) ---
CAMOFOX_BASE_URL=http://localhost:9377

# --- Live Browser Automation Hub ---
BROWSER_HUB_PORT=7860
PLAYWRIGHT_HEADLESS=false

# --- External Search & AI APIs (Optional) ---
EXA_API_KEY=
BRAVE_API_KEY=
GITHUB_TOKEN=
LINEAR_API_KEY=
SENTRY_AUTH_TOKEN=
