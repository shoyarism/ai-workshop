{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "nvidia/nemotron-3-ultra-550b-a55b",
  "small_model": "omniroute/best-fast",
  "default_agent": "build",
  "subagent_depth": 3,
  "enabled_providers": [
    "9router",
    "cerebras",
    "chutes",
    "cohere",
    "deepseek",
    "freellmapi",
    "groq",
    "hyperbolic",
    "mistral",
    "nvidia",
    "omniroute",
    "openrouter",
    "siliconflow",
    "together",
    "tokenrouter",
    "venice"
  ],
  "disabled_providers": [
    "anthropic",
    "gemini",
    "github-copilot",
    "google",
    "kilocode",
    "openai",
    "opencode"
  ],
  "skills": {
    "paths": [
      "./skills",
      "./.workshop_state/skills-core",
      "./ui-ux-arsenal",
      "./ai agents handbook/packs/ponytail/skills",
      "./ai agents handbook/packs/styleseed/skills",
      "./ai agents handbook/packs/garden-skills/skills",
      "./hyperframes/skills",
      "./browser-use/skills"
    ]
  },
  "instructions": [
    "./AGENTS.md",
    "./docs/WORKSHOP.md",
    "./docs/WORKSHOP_ARSENAL.md",
    "./docs/OPENCODE.md"
  ],
  "permission": {
    "*": "allow",
    "read": "allow",
    "edit": "allow",
    "apply_patch": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todo": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "todorun": "allow",
    "web_search": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "fetch": "allow",
    "browser": "allow",
    "command": "allow",
    "terminal": "allow",
    "question": "allow",
    "skill": "allow",
    "lsp": "allow",
    "doom_loop": "allow"
  },
  "tools": {
    "*": true,
    "read": true,
    "edit": true,
    "apply_patch": true,
    "glob": true,
    "grep": true,
    "list": true,
    "bash": true,
    "task": true,
    "todo": true,
    "todowrite": true,
    "todoread": true,
    "todorun": true,
    "web_search": true,
    "websearch": true,
    "webfetch": true,
    "fetch": true,
    "browser": true,
    "command": true,
    "question": true,
    "skill": true,
    "lsp": true
  },
  "formatter": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 100
  },
  "indexing": {
    "enabled": true
  },
  "web_search": true,
  "plugin": [
    "@kilocode/kilo-indexing",
    "@kilocode/plugin-atomic-chat"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "ai-dev-jobs": {
      "type": "remote",
      "url": "https://aidevboard.com/mcp",
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "omniroute": {
      "type": "remote",
      "url": "http://127.0.0.1:20128/api/mcp/sse",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true
    },
    "puppeteer": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-fetch"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx",
        "-y",
        "mcp-server-git"
      ],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "./.omniroute/data.sqlite"
      ],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres"
      ],
      "enabled": true
    },
    "docker": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-docker"
      ],
      "enabled": true
    },
    "firebase": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx",
        "-y",
        "firebase-tools@latest",
        "mcp"
      ],
      "enabled": true
    },
    "terraform": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx",
        "-y",
        "mcp-terraform"
      ],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "enabled": true
    },
    "camofox": {
      "type": "local",
      "command": [
        "node",
        "./camofox-browser/mcp/server.mjs"
      ],
      "environment": {
        "CAMOFOX_BASE_URL": "http://localhost:9377"
      },
      "enabled": true
    },
    "workshop": {
      "type": "local",
      "command": [
        "python",
        "./scripts/workshop_mcp.py"
      ],
      "environment": {
        "WORKSHOP_ROOT": ".",
        "PYTHONIOENCODING": "utf-8"
      },
      "enabled": true
    }
  },
