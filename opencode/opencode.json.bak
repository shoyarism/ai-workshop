{
  "$schema": "https://opencode.ai/config.json",
  "model": "omniroute/best-coding",
  "small_model": "omniroute/best-fast",
  "default_agent": "general",
  "subagent_depth": 3,
  "enabled_providers": [
    "omniroute"
  ],
  "disabled_providers": [
    "google",
    "gemini",
    "anthropic",
    "github-copilot",
    "freellmapi",
    "kilocode",
    "openrouter",
    "opencode",
    "openai"
  ],
  "skills": {
    "paths": [
      "~/.gemini/config/plugins/science/skills",
      "~/.gemini/antigravity/builtin/skills",
      "./skills"
    ]
  },
  "instructions": [
    "OPENCODE.md",
    "AGENTS.md",
    "OPENCODE_GUIDE.md",
    "OPENCODE_ARSENAL.md"
  ],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow"
  },
  "tools": {
    "read": true,
    "edit": true,
    "glob": true,
    "grep": true,
    "list": true,
    "bash": true,
    "task": true,
    "todowrite": true
  },
  "formatter": true,
